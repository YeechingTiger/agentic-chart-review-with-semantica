# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Run output is an EXPERIMENTAL RECORD, not a build product. Deleting it destroys data.
# Traces are large, so they stay out of git; manifests are ~2KB of evidence and go in.
runs/**/*.jsonl
*.jsonl.gz
!runs/**/*.manifest.json
!runs/_archive/**

# Real corpora must never be committed. Synthetic dev corpus IS committed
# (corpus/patients/) because it is fabricated and PHI-free.
corpus_real/
data_real/

# Env
.env
.env.*
!.env.example

# OS / editors
.DS_Store
.idea/
.vscode/

# Reference copy of the prior platform (not ours to redistribute)
_chartreview_ref/

# Second venv for the deepagents runtime
.venv-deep/

# Document-type vocabulary cache, rebuilt on demand (39min -> 10s)
corpus/patients/.doc_type_vocab.json

# Second venv for the deepagents runtime
.venv-deep/

# Document-type vocabulary cache, rebuilt on demand
corpus/patients/.doc_type_vocab.json

# Run output from REAL patients never enters git, manifest or not. The rule
# above ("manifests are 2KB of evidence and go in") was written when every run
# was against the synthetic corpus. A real run puts the patient id in the
# directory NAME and in the manifest, so committing one is a PHI disclosure
# that tests/test_no_phi_in_tree.py catches only after the fact -- as it did.
runs/*_1168*/
runs/**/*_1168*/
