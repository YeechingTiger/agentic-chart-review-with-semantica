# OpenRouter Responses-compatible endpoint used by the Codex harness.
ACR_API_BASE=https://openrouter.ai/api/v1
ACR_API_KEY=
ACR_MODEL=openai/gpt-5.6-luna

# The same OpenRouter account is used by the LiteLLM reconstruction adapter.
OPENROUTER_API_KEY=

# Local Langtrace project. Official Docker Compose defaults to port 3000.
LANGTRACE_API_HOST=http://127.0.0.1:3000
LANGTRACE_PROJECT_ID=acr_chart_review
LANGTRACE_API_KEY=

# Choose a strong local-only value before starting `acr review-ui`.
SEMANTICA_API_KEY=
