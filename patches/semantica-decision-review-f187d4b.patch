diff --git a/explorer/src/workspaces/DecisionWorkspace/DecisionNarrativeWorkspace.tsx b/explorer/src/workspaces/DecisionWorkspace/DecisionNarrativeWorkspace.tsx
new file mode 100644
index 0000000..569e73f
--- /dev/null
+++ b/explorer/src/workspaces/DecisionWorkspace/DecisionNarrativeWorkspace.tsx
@@ -0,0 +1,493 @@
+import { useCallback, useEffect, useState, type ReactNode } from "react";
+import { AlertTriangle, ArrowLeft, ArrowRight, BookOpen, Check, Eye, KeyRound } from "lucide-react";
+
+export type ApiRequest = (input: RequestInfo | URL, init?: RequestInit) => Promise<Response>;
+
+type BundleSummary = {
+  bundle_id: string;
+  title: string;
+  subtitle?: string;
+  step_count: number;
+  has_conclusion: boolean;
+  updated_at?: string;
+};
+
+type NarrativeAction = { name?: string; objective?: string; observation?: string };
+type NarrativeBasis = { kind?: string; label?: string; reference?: string; status?: string };
+type Attention = { code?: string; title?: string; detail?: string; severity?: string };
+type NarrativeStep = {
+  entity_id: string;
+  bundle_id: string;
+  order: number;
+  title?: string;
+  question?: string;
+  known_before?: string[];
+  rationale?: string;
+  actions?: NarrativeAction[];
+  observations?: string[];
+  candidate_changes?: { before?: unknown[]; after?: unknown[] };
+  basis?: NarrativeBasis[];
+  decision?: unknown;
+  why_next_or_stop?: string;
+  attention?: Attention[];
+  trace_links?: { label?: string; href?: string; ref?: string }[];
+  is_conclusion?: boolean;
+};
+
+type StepReview = {
+  verdict: "" | "CORRECT" | "INCORRECT" | "UNSURE";
+  corrected_decision: string;
+  issue_source: "NONE" | "DECISION_JUDGMENT" | "POLICY_GAP" | "EVIDENCE_OR_TOOLING" | "TRACE_INSUFFICIENT";
+  materiality: "NOT_APPLICABLE" | "CHANGES_FINAL" | "DOES_NOT_CHANGE_FINAL" | "UNKNOWN";
+  note: string;
+};
+
+const emptyReview = (): StepReview => ({
+  verdict: "", corrected_decision: "", issue_source: "NONE",
+  materiality: "NOT_APPLICABLE", note: "",
+});
+
+function humanKey(value: string): string {
+  const spaced = value.replaceAll("_", " ");
+  return spaced.charAt(0).toUpperCase() + spaced.slice(1);
+}
+
+function bundleIdentity(row: BundleSummary): string {
+  const analysis = row.subtitle?.match(/analysis ([^ ·]+)/)?.[1];
+  const run = row.subtitle?.match(/run ([^ ·]+)/)?.[1];
+  return analysis && run ? `${run}:${analysis}` : row.bundle_id;
+}
+
+function bundleDetail(row: BundleSummary): string {
+  const analysis = row.subtitle?.match(/analysis ([^ ·]+)/)?.[1];
+  return analysis || row.subtitle || row.bundle_id;
+}
+
+function text(value: unknown): string {
+  if (value === null || value === undefined || value === "") return "—";
+  if (typeof value === "string") return /^\d{8}$/.test(value)
+    ? `${value.slice(0, 4)}-${value.slice(4, 6)}-${value.slice(6, 8)}` : value;
+  if (typeof value === "number") return String(value);
+  if (typeof value === "boolean") return value ? "yes" : "no";
+  if (Array.isArray(value)) return value.map(text).join(" · ");
+  return Object.entries(value as Record<string, unknown>)
+    .map(([key, item]) => `${humanKey(key)}: ${text(item)}`).join(" · ");
+}
+
+function Section({ title, children }: { title: string; children: ReactNode }) {
+  return (
+    <section style={{ padding: "18px 0", borderTop: "1px solid var(--ws-border)" }}>
+      <div className="ws-label">{title}</div>
+      {children}
+    </section>
+  );
+}
+
+function Bullets({ values }: { values?: string[] }) {
+  if (!values?.length) return <div className="ws-body">Nothing recorded.</div>;
+  return (
+    <ul style={{ margin: 0, paddingLeft: 20, color: "var(--ws-text)", lineHeight: 1.65 }}>
+      {values.map((value, index) => <li key={`${value}-${index}`}>{value}</li>)}
+    </ul>
+  );
+}
+
+function Choice({ name, value, current, label, onChange }: {
+  name: string; value: string; current: string; label: string; onChange: (value: string) => void;
+}) {
+  const active = current === value;
+  return (
+    <label style={{ display: "flex", gap: 8, alignItems: "center", cursor: "pointer",
+      padding: "10px 12px", borderRadius: 9,
+      border: `1px solid ${active ? "var(--ws-accent)" : "var(--ws-border)"}`,
+      background: active ? "var(--ws-accent-soft)" : "var(--ws-surface)" }}>
+      <input type="radio" name={name} value={value} checked={active}
+        onChange={() => onChange(value)} />
+      <span style={{ color: "var(--ws-text)", fontSize: 13, fontWeight: 700 }}>{label}</span>
+    </label>
+  );
+}
+
+function StepAdjudication({ step, value, onChange }: {
+  step: NarrativeStep; value: StepReview; onChange: (next: StepReview) => void;
+}) {
+  const setVerdict = (verdict: StepReview["verdict"]) => {
+    if (verdict === "CORRECT") onChange({ ...emptyReview(), verdict });
+    else if (verdict === "UNSURE") onChange({ ...emptyReview(), verdict,
+      issue_source: "TRACE_INSUFFICIENT", materiality: "UNKNOWN" });
+    else onChange({ ...value, verdict, issue_source: value.issue_source === "NONE"
+      ? "DECISION_JUDGMENT" : value.issue_source,
+      materiality: value.materiality === "NOT_APPLICABLE" ? "UNKNOWN" : value.materiality });
+  };
+  return (
+    <Section title="Your judgment">
+      <div style={{ display: "grid", gridTemplateColumns: "repeat(3,minmax(0,1fr))", gap: 8 }}>
+        <Choice name={`verdict-${step.entity_id}`} value="CORRECT" current={value.verdict}
+          label="Correct" onChange={(v) => setVerdict(v as StepReview["verdict"])} />
+        <Choice name={`verdict-${step.entity_id}`} value="INCORRECT" current={value.verdict}
+          label="Incorrect" onChange={(v) => setVerdict(v as StepReview["verdict"])} />
+        <Choice name={`verdict-${step.entity_id}`} value="UNSURE" current={value.verdict}
+          label="Cannot tell" onChange={(v) => setVerdict(v as StepReview["verdict"])} />
+      </div>
+      {value.verdict === "INCORRECT" && (
+        <div style={{ display: "grid", gap: 10, marginTop: 12, padding: 14,
+          borderRadius: 10, background: "var(--ws-red-soft)" }}>
+          <label><span className="ws-label">Correct decision</span>
+            <textarea className="ws-input" value={value.corrected_decision}
+              onChange={(e) => onChange({ ...value, corrected_decision: e.target.value })} />
+          </label>
+          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
+            <label><span className="ws-label">Problem source</span>
+              <select className="ws-input" value={value.issue_source}
+                onChange={(e) => onChange({ ...value,
+                  issue_source: e.target.value as StepReview["issue_source"] })}>
+                <option value="DECISION_JUDGMENT">Decision judgment</option>
+                <option value="POLICY_GAP">Policy / guideline gap</option>
+                <option value="EVIDENCE_OR_TOOLING">Evidence / tooling</option>
+                <option value="TRACE_INSUFFICIENT">Trace insufficient</option>
+              </select>
+            </label>
+            <label><span className="ws-label">Effect on final answer</span>
+              <select className="ws-input" value={value.materiality}
+                onChange={(e) => onChange({ ...value,
+                  materiality: e.target.value as StepReview["materiality"] })}>
+                <option value="UNKNOWN">Unknown</option>
+                <option value="CHANGES_FINAL">Changes final answer</option>
+                <option value="DOES_NOT_CHANGE_FINAL">Does not change final answer</option>
+              </select>
+            </label>
+          </div>
+        </div>
+      )}
+      {value.verdict && (
+        <label style={{ display: "block", marginTop: 12 }}><span className="ws-label">Review note (optional)</span>
+          <textarea className="ws-input" value={value.note}
+            onChange={(e) => onChange({ ...value, note: e.target.value })} />
+        </label>
+      )}
+    </Section>
+  );
+}
+
+function NarrativeCard({ step, index, total, review, onReview }: {
+  step: NarrativeStep; index: number; total: number; review: StepReview;
+  onReview: (value: StepReview) => void;
+}) {
+  const before = step.candidate_changes?.before || [];
+  const after = step.candidate_changes?.after || [];
+  return (
+    <div className="ws-card" style={{ maxWidth: 900, margin: "0 auto", padding: 28 }}>
+      <div className="ws-eyebrow">Step {index + 1} of {total}</div>
+      <h2 className="ws-title" style={{ margin: "7px 0 2px", maxWidth: 760 }}>
+        {step.title || "Decision step"}
+      </h2>
+
+      <Section title="Question still open">
+        <div style={{ color: "var(--ws-text)", fontSize: 18, lineHeight: 1.5 }}>
+          {step.question || "No explicit question was recorded."}
+        </div>
+      </Section>
+      <Section title="Decision made">
+        <div style={{ padding: 16, borderRadius: 10, background: "var(--ws-accent-soft)",
+          borderLeft: "3px solid var(--ws-accent)", color: "var(--ws-text)",
+          fontSize: 17, fontWeight: 700 }}>{text(step.decision)}</div>
+      </Section>
+      <Section title="Why the agent chose it">
+        <div className="ws-body" style={{ color: "var(--ws-text)", fontSize: 14 }}>
+          {step.rationale || "No contemporaneous rationale was recorded."}
+        </div>
+      </Section>
+      {!!step.attention?.length && <Section title="What needs human attention">
+        <div style={{ display: "grid", gap: 8 }}>
+          {step.attention.map((item, i) => <div key={i} style={{ padding: 12,
+            borderRadius: 9, background: "var(--ws-amber-soft)", display: "flex", gap: 9 }}>
+            <AlertTriangle size={16} color="var(--ws-amber)" />
+            <div><strong style={{ color: "var(--ws-text)" }}>{item.title || item.code}</strong>
+              {item.detail && <div className="ws-body">{item.detail}</div>}</div>
+          </div>)}
+        </div>
+      </Section>}
+      <Section title="Evidence available before this decision"><Bullets values={step.known_before} /></Section>
+      {!!step.actions?.length && <Section title="Action → observation">
+        <div style={{ display: "grid", gap: 8 }}>
+          {step.actions.map((action, i) => (
+            <div key={i} style={{ padding: 12, borderRadius: 9, background: "rgba(255,255,255,.025)" }}>
+              <strong style={{ color: "var(--ws-text)" }}>{action.name || "Action"}</strong>
+              {action.objective && <span className="ws-body"> — {action.objective}</span>}
+              {action.observation && <div className="ws-body" style={{ marginTop: 5 }}>
+                Observed: {action.observation}</div>}
+            </div>
+          ))}
+        </div>
+      </Section>}
+      {!!step.observations?.length && <Section title="Evidence added or changed">
+        <Bullets values={step.observations} />
+      </Section>}
+      {(before.length > 0 || after.length > 0) && <Section title="Evidence and alternatives">
+        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit,minmax(260px,1fr))", gap: 12 }}>
+          <div className="ws-panel--inset" style={{ padding: 12, overflowWrap: "anywhere" }}>
+            <span className="ws-label">Evidence entering this decision</span>{text(before)}</div>
+          <div className="ws-panel--inset" style={{ padding: 12, overflowWrap: "anywhere" }}>
+            <span className="ws-label">Options considered</span>{text(after)}</div>
+        </div>
+      </Section>}
+      {!!step.basis?.length && <Section title="What the decision relied on">
+        <div style={{ display: "flex", flexWrap: "wrap", gap: 7 }}>
+          {step.basis.map((basis, i) => {
+            const own = basis.kind === "own_knowledge";
+            return <span key={i} className="ws-pill" style={own ? {
+              color: "var(--ws-red)", borderColor: "rgba(255,123,114,.35)",
+              background: "var(--ws-red-soft)" } : undefined}>
+              {basis.label || basis.reference || basis.kind || "basis"}
+              {basis.status ? ` · ${basis.status}` : ""}
+            </span>;
+          })}
+        </div>
+      </Section>}
+      {step.why_next_or_stop && <Section title="Why continue or stop">
+        <div className="ws-body" style={{ color: "var(--ws-text)" }}>{step.why_next_or_stop}</div>
+      </Section>}
+      {!!step.trace_links?.length && <Section title="Audit trail">
+        <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
+          {step.trace_links.map((link, i) => link.href
+            ? <a className="ws-btn ws-btn--secondary" key={i} href={link.href}
+                target="_blank" rel="noreferrer"><Eye size={13} />{link.label || link.ref || "Open trace"}</a>
+            : <span className="ws-pill ws-pill--mono" key={i}>{link.ref}</span>)}
+        </div>
+      </Section>}
+      <StepAdjudication step={step} value={review} onChange={onReview} />
+    </div>
+  );
+}
+
+function ApiKeyPrompt({ onSubmit, error }: { onSubmit: (key: string) => void; error?: string }) {
+  const [key, setKey] = useState("");
+  return (
+    <div className="ws-page" style={{ display: "grid", placeItems: "center" }}>
+      <form className="ws-card" style={{ width: 440, padding: 28 }} onSubmit={(e) => {
+        e.preventDefault(); if (key.trim()) onSubmit(key.trim());
+      }}>
+        <div style={{ width: 42, height: 42, borderRadius: 12, display: "grid", placeItems: "center",
+          background: "var(--ws-accent-soft)", color: "var(--ws-accent)", marginBottom: 16 }}>
+          <KeyRound size={20} />
+        </div>
+        <h2 className="ws-title">Open Decision Review</h2>
+        <p className="ws-body">Enter the Explorer API key. It stays in this workspace's memory and is sent only as the X-API-Key header.</p>
+        <input className="ws-input" type="password" autoComplete="off" value={key}
+          onChange={(e) => setKey(e.target.value)} placeholder="Semantica API key" />
+        {error && <div style={{ color: "var(--ws-red)", marginTop: 9 }}>{error}</div>}
+        <button className="ws-btn ws-btn--primary" style={{ marginTop: 14 }} type="submit">Continue</button>
+      </form>
+    </div>
+  );
+}
+
+export function DecisionNarrativeWorkspace({ fallback }: {
+  fallback: (request: ApiRequest) => ReactNode;
+}) {
+  const [apiKey, setApiKey] = useState("");
+  const [needsKey, setNeedsKey] = useState(false);
+  const [bundles, setBundles] = useState<BundleSummary[] | null>(null);
+  const [selectedBundle, setSelectedBundle] = useState("");
+  const [steps, setSteps] = useState<NarrativeStep[]>([]);
+  const [stepsLoading, setStepsLoading] = useState(false);
+  const [reviews, setReviews] = useState<Record<string, StepReview>>({});
+  const [stage, setStage] = useState(0);
+  const [reviewer, setReviewer] = useState("");
+  const [finalVerdict, setFinalVerdict] = useState<"" | "CORRECT" | "INCORRECT" | "UNSURE">("");
+  const [finalSource, setFinalSource] = useState("NONE");
+  const [finalRationale, setFinalRationale] = useState("");
+  const [historyCount, setHistoryCount] = useState(0);
+  const [error, setError] = useState("");
+  const [saved, setSaved] = useState<Record<string, unknown> | null>(null);
+
+  const request = useCallback<ApiRequest>((input, init = {}) => {
+    const headers = new Headers(init.headers || {});
+    if (apiKey) headers.set("X-API-Key", apiKey);
+    return fetch(input, { ...init, headers });
+  }, [apiKey]);
+
+  useEffect(() => {
+    const ctrl = new AbortController();
+    setBundles(null); setSelectedBundle(""); setSteps([]); setError("");
+    request("/api/decision-review/bundles", { signal: ctrl.signal })
+      .then(async (response) => {
+        if (response.status === 401 || response.status === 503) {
+          setNeedsKey(true); throw new Error(response.status === 401 ? "Invalid API key" : "Explorer authentication is not configured");
+        }
+        if (!response.ok) throw new Error(`HTTP ${response.status}`);
+        setNeedsKey(false); return response.json();
+      })
+      .then((data: BundleSummary[]) => {
+        if (ctrl.signal.aborted) return;
+        const visible = data.filter((row, index) =>
+          data.findIndex((candidate) => bundleIdentity(candidate) === bundleIdentity(row)) === index);
+        setBundles(visible);
+        const requested = new URLSearchParams(window.location.search).get("bundle_id");
+        const initial = visible.find((row) => row.bundle_id === requested)?.bundle_id || visible[0]?.bundle_id || "";
+        setSelectedBundle(initial);
+      })
+      .catch((cause) => { if (cause?.name !== "AbortError") setError(String(cause.message || cause)); });
+    return () => ctrl.abort();
+  }, [request]);
+
+  useEffect(() => {
+    if (!selectedBundle) return;
+    const ctrl = new AbortController(); setError(""); setSaved(null); setStage(0);
+    setSteps([]); setStepsLoading(true);
+    Promise.all([
+      request(`/api/decision-review/bundles/${encodeURIComponent(selectedBundle)}`, { signal: ctrl.signal }),
+      request(`/api/decision-review/bundles/${encodeURIComponent(selectedBundle)}/reviews`, { signal: ctrl.signal }),
+    ]).then(async ([bundleResponse, historyResponse]) => {
+      if (!bundleResponse.ok || !historyResponse.ok) throw new Error(`HTTP ${bundleResponse.status}/${historyResponse.status}`);
+      return Promise.all([bundleResponse.json(), historyResponse.json()]);
+    }).then(([bundle, history]) => {
+      if (ctrl.signal.aborted) return;
+      setSteps(bundle.steps || []); setStepsLoading(false);
+      setHistoryCount(history.reviews?.length || 0);
+      const next: Record<string, StepReview> = {};
+      (bundle.steps || []).filter((row: NarrativeStep) => !row.is_conclusion)
+        .forEach((row: NarrativeStep) => { next[row.entity_id] = emptyReview(); });
+      setReviews(next);
+    }).catch((cause) => { if (cause?.name !== "AbortError") {
+      setStepsLoading(false); setError(String(cause.message || cause));
+    }});
+    return () => ctrl.abort();
+  }, [request, selectedBundle]);
+
+  if (needsKey) return <ApiKeyPrompt error={apiKey ? error : undefined}
+    onSubmit={(value) => { setApiKey(value); setNeedsKey(false); }} />;
+  if (bundles === null) return <div className="ws-page" style={{ display: "grid", placeItems: "center" }}><div className="ws-skeleton" style={{ width: 380, height: 180 }} /></div>;
+  if (bundles.length === 0) return <>{fallback(request)}</>;
+
+  const narrativeSteps = steps.filter((row) => !row.is_conclusion);
+  const conclusion = steps.find((row) => row.is_conclusion);
+  const onConclusion = stage >= narrativeSteps.length;
+  const current = narrativeSteps[Math.min(stage, Math.max(narrativeSteps.length - 1, 0))];
+  const bundle = bundles.find((row) => row.bundle_id === selectedBundle);
+
+  async function save() {
+    setError("");
+    const verdicts = narrativeSteps.map((row) => ({ step_id: row.entity_id, ...reviews[row.entity_id] }));
+    if (!reviewer.trim() || !finalVerdict || !finalRationale.trim()
+        || verdicts.some((row) => !row.verdict)) {
+      setError("Complete every step verdict, reviewer, final verdict, and final rationale before saving.");
+      return;
+    }
+    const response = await request(`/api/decision-review/bundles/${encodeURIComponent(selectedBundle)}/reviews`, {
+      method: "POST", headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        review_id: globalThis.crypto?.randomUUID?.() || `review-${Date.now()}`,
+        reviewer, step_verdicts: verdicts,
+        final_answer_verdict: finalVerdict, final_issue_source: finalSource,
+        final_rationale: finalRationale,
+      }),
+    });
+    const payload = await response.json();
+    if (!response.ok) { setError(payload.detail || `HTTP ${response.status}`); return; }
+    setSaved(payload.record); setHistoryCount((value) => value + (payload.created ? 1 : 0));
+  }
+
+  return (
+    <div className="ws-page" style={{ flexDirection: "row" }}>
+      <aside className="ws-sidebar" style={{ width: 285 }}>
+        <div className="ws-sidebar-header">
+          <div style={{ display: "flex", gap: 9, alignItems: "center" }}><BookOpen size={17} color="var(--ws-accent)" />
+            <strong style={{ color: "var(--ws-text)" }}>Decision Review</strong></div>
+          <div className="ws-body" style={{ marginTop: 7 }}>Follow the evidence and decisions in reading order.</div>
+        </div>
+        <div className="ws-sidebar-body" style={{ display: "grid", gap: 5, overflowX: "hidden" }}>
+          {bundles.map((row) => <button key={row.bundle_id}
+            className={`ws-list-item${selectedBundle === row.bundle_id ? " ws-list-item--active" : ""}`}
+            style={{ minWidth: 0, maxWidth: "100%", overflow: "hidden" }}
+            onClick={() => setSelectedBundle(row.bundle_id)}>
+            <div style={{ color: "var(--ws-text)", fontWeight: 700, whiteSpace: "normal",
+              overflowWrap: "anywhere", lineHeight: 1.3 }}>{row.title}</div>
+            <div className="ws-body">{row.step_count} decision step{row.step_count === 1 ? "" : "s"}</div>
+            <div className="ws-body" title={row.subtitle} style={{ marginTop: 3,
+              whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>{bundleDetail(row)}</div>
+          </button>)}
+        </div>
+      </aside>
+      <main style={{ flex: 1, overflow: "hidden", display: "flex", flexDirection: "column" }}>
+        <header style={{ padding: "16px 24px", borderBottom: "1px solid var(--ws-border)",
+          display: "flex", flexWrap: "wrap", justifyContent: "space-between", alignItems: "center", gap: 12 }}>
+          <div><div className="ws-eyebrow">{onConclusion ? "Conclusion" : "Human reading path"}</div>
+            <strong style={{ color: "var(--ws-text)", fontSize: 16 }}>{bundle?.title}</strong>
+            {bundle && <span className="ws-body"> · {bundleDetail(bundle)}</span>}</div>
+          <div style={{ display: "flex", gap: 6 }}>
+            {narrativeSteps.map((row, index) => <button key={row.entity_id}
+              title={`Step ${index + 1}`} onClick={() => setStage(index)}
+              style={{ width: 28, height: 28, borderRadius: 999, cursor: "pointer",
+                border: `1px solid ${stage === index ? "var(--ws-accent)" : "var(--ws-border)"}`,
+                background: reviews[row.entity_id]?.verdict ? "var(--ws-green-soft)" : "var(--ws-surface)",
+                color: reviews[row.entity_id]?.verdict ? "var(--ws-green)" : "var(--ws-text-muted)" }}>
+              {reviews[row.entity_id]?.verdict ? <Check size={13} /> : index + 1}
+            </button>)}
+            <button title="Conclusion" onClick={() => setStage(narrativeSteps.length)}
+              style={{ width: 34, height: 28, borderRadius: 999, cursor: "pointer",
+                border: `1px solid ${onConclusion ? "var(--ws-accent)" : "var(--ws-border)"}`,
+                background: "var(--ws-surface)", color: "var(--ws-text-muted)" }}>Final</button>
+          </div>
+        </header>
+        {error && <div style={{ margin: "12px 24px 0", padding: 10, color: "var(--ws-red)",
+          background: "var(--ws-red-soft)", borderRadius: 8 }}>{error}</div>}
+        <div className="ws-scroll ws-padded">
+          {stepsLoading ? <div className="ws-card" style={{ maxWidth: 900, height: 420,
+            margin: "0 auto" }}><div className="ws-skeleton" style={{ height: "100%" }} /></div>
+          : !onConclusion && current ? <NarrativeCard step={current} index={stage}
+            total={narrativeSteps.length} review={reviews[current.entity_id] || emptyReview()}
+            onReview={(value) => setReviews({ ...reviews, [current.entity_id]: value })} /> : (
+            <div className="ws-card" style={{ maxWidth: 900, margin: "0 auto", padding: 28 }}>
+              <div className="ws-eyebrow">Final conclusion — revealed after the decision path</div>
+              <h2 className="ws-title" style={{ margin: "8px 0 18px" }}>{conclusion?.title || "Conclusion"}</h2>
+              <div style={{ padding: 18, borderRadius: 11, background: "var(--ws-green-soft)",
+                borderLeft: "4px solid var(--ws-green)", color: "var(--ws-text)", fontSize: 20,
+                fontWeight: 800 }}>{text(conclusion?.decision)}</div>
+              {conclusion?.rationale && <Section title="Why"><div className="ws-body"
+                style={{ color: "var(--ws-text)" }}>{conclusion.rationale}</div></Section>}
+              {conclusion?.why_next_or_stop && <Section title="Why the agent stopped"><div
+                className="ws-body" style={{ color: "var(--ws-text)" }}>{conclusion.why_next_or_stop}</div></Section>}
+              <Section title="Final human assessment">
+                <div style={{ display: "grid", gridTemplateColumns: "repeat(3,minmax(0,1fr))", gap: 8 }}>
+                  {(["CORRECT", "INCORRECT", "UNSURE"] as const).map((value) =>
+                    <Choice key={value} name="final-verdict" value={value} current={finalVerdict}
+                      label={{ CORRECT: "Correct", INCORRECT: "Incorrect", UNSURE: "Cannot tell" }[value]}
+                      onChange={(next) => { setFinalVerdict(next as typeof finalVerdict);
+                        setFinalSource(next === "CORRECT" ? "NONE" : next === "UNSURE" ? "TRACE_INSUFFICIENT" : "DECISION_JUDGMENT"); }} />)}
+                </div>
+                {finalVerdict === "INCORRECT" && <label style={{ display: "block", marginTop: 12 }}>
+                  <span className="ws-label">Final problem source</span>
+                  <select className="ws-input" value={finalSource} onChange={(e) => setFinalSource(e.target.value)}>
+                    <option value="DECISION_JUDGMENT">Decision judgment</option>
+                    <option value="POLICY_GAP">Policy / guideline gap</option>
+                    <option value="EVIDENCE_OR_TOOLING">Evidence / tooling</option>
+                    <option value="TRACE_INSUFFICIENT">Trace insufficient</option>
+                  </select></label>}
+                <label style={{ display: "block", marginTop: 12 }}><span className="ws-label">Reviewer</span>
+                  <input className="ws-input" value={reviewer} onChange={(e) => setReviewer(e.target.value)} /></label>
+                <label style={{ display: "block", marginTop: 12 }}><span className="ws-label">Final rationale</span>
+                  <textarea className="ws-input" value={finalRationale}
+                    onChange={(e) => setFinalRationale(e.target.value)} /></label>
+                <button className="ws-btn ws-btn--primary" style={{ marginTop: 14 }} onClick={() => void save()}>
+                  Save to Semantica audit provenance</button>
+                <div className="ws-body" style={{ marginTop: 8 }}>{historyCount} prior durable review{historyCount === 1 ? "" : "s"}.</div>
+                {saved && <div style={{ marginTop: 12, padding: 12, borderRadius: 9,
+                  background: "var(--ws-green-soft)", color: "var(--ws-green)" }}>
+                  Review saved. Root attribution: {text((saved.derived as Record<string, unknown>)?.primary_issue_source)}.
+                </div>}
+              </Section>
+            </div>
+          )}
+        </div>
+        <footer style={{ padding: "12px 24px", borderTop: "1px solid var(--ws-border)",
+          display: "flex", justifyContent: "space-between" }}>
+          <button className="ws-btn ws-btn--secondary" disabled={stage === 0}
+            onClick={() => setStage(Math.max(0, stage - 1))}><ArrowLeft size={14} />Previous</button>
+          <button className="ws-btn ws-btn--primary" disabled={onConclusion}
+            onClick={() => setStage(Math.min(narrativeSteps.length, stage + 1))}>Next<ArrowRight size={14} /></button>
+        </footer>
+      </main>
+    </div>
+  );
+}
diff --git a/semantica/explorer/decision_review.py b/semantica/explorer/decision_review.py
