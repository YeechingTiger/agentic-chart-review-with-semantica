+++ b/semantica/explorer/decision_review.py
@@ -0,0 +1,320 @@
+"""Human-readable decision narratives and audit-grade human reviews.
+
+The narrative is a read model projected by an application into Semantica's
+``ProvenanceManager``.  It does not replace Decision nodes or causal edges.  A
+review is another provenance entity generated by a human review activity, so
+review history is durable, append-only, and covered by Semantica's integrity
+chain instead of the Explorer's in-memory annotations.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+from typing import Any, Literal, Optional
+
+from pydantic import BaseModel, Field, field_validator, model_validator
+
+
+NARRATIVE_SCHEMA = "semantica.decision_narrative.v1"
+REVIEW_SCHEMA = "semantica.decision_review.v1"
+_SAFE_ID = re.compile(r"^[A-Za-z0-9_.:-]{1,240}$")
+
+
+class StepVerdict(BaseModel):
+    """One human verdict over one narrative step."""
+
+    step_id: str
+    verdict: Literal["CORRECT", "INCORRECT", "UNSURE"]
+    corrected_decision: Optional[str] = Field(default=None, max_length=8000)
+    issue_source: Literal[
+        "NONE", "DECISION_JUDGMENT", "POLICY_GAP", "EVIDENCE_OR_TOOLING",
+        "TRACE_INSUFFICIENT",
+    ] = "NONE"
+    materiality: Literal[
+        "NOT_APPLICABLE", "CHANGES_FINAL", "DOES_NOT_CHANGE_FINAL", "UNKNOWN",
+    ] = "NOT_APPLICABLE"
+    note: Optional[str] = Field(default=None, max_length=8000)
+
+    @field_validator("step_id")
+    @classmethod
+    def validate_step_id(cls, value: str) -> str:
+        value = value.strip()
+        if not value or len(value) > 500:
+            raise ValueError("step_id is invalid")
+        return value
+
+    @model_validator(mode="after")
+    def validate_verdict(self) -> "StepVerdict":
+        if self.verdict == "CORRECT":
+            if (self.issue_source != "NONE" or self.materiality != "NOT_APPLICABLE"
+                    or self.corrected_decision):
+                raise ValueError(
+                    "a correct step cannot include an issue source, materiality, or correction"
+                )
+        elif self.verdict == "INCORRECT":
+            if not (self.corrected_decision or "").strip():
+                raise ValueError("an incorrect step requires corrected_decision")
+            if self.issue_source == "NONE":
+                raise ValueError("an incorrect step requires issue_source")
+            if self.materiality == "NOT_APPLICABLE":
+                raise ValueError("an incorrect step requires materiality")
+        else:
+            if self.issue_source not in {"NONE", "TRACE_INSUFFICIENT"}:
+                raise ValueError("an unsure step may only use TRACE_INSUFFICIENT")
+            self.materiality = "UNKNOWN"
+        return self
+
+
+class DecisionReviewSubmission(BaseModel):
+    """A complete human review of one ordered narrative bundle."""
+
+    review_id: str
+    reviewer: str = Field(min_length=1, max_length=300)
+    step_verdicts: list[StepVerdict]
+    final_answer_verdict: Literal["CORRECT", "INCORRECT", "UNSURE"]
+    final_issue_source: Literal[
+        "NONE", "DECISION_JUDGMENT", "POLICY_GAP", "EVIDENCE_OR_TOOLING",
+        "TRACE_INSUFFICIENT",
+    ] = "NONE"
+    final_rationale: str = Field(min_length=1, max_length=8000)
+
+    @field_validator("review_id")
+    @classmethod
+    def validate_review_id(cls, value: str) -> str:
+        value = value.strip()
+        if not _SAFE_ID.fullmatch(value):
+            raise ValueError("review_id must contain only letters, numbers, '.', ':', '_' or '-'")
+        return value
+
+    @field_validator("reviewer", "final_rationale")
+    @classmethod
+    def strip_required_text(cls, value: str) -> str:
+        value = value.strip()
+        if not value:
+            raise ValueError("value must not be blank")
+        return value
+
+
+def _audit_rows(manager: Any, entity_type: str) -> list[dict[str, Any]]:
+    rows = manager.audit_log(format="json")
+    return [row for row in rows if row.get("entity_type") == entity_type
+            and not row.get("invalidated")]
+
+
+def list_narratives(manager: Any, bundle_id: str | None = None) -> list[dict[str, Any]]:
+    """Read current narrative entities from Semantica provenance."""
+    rows: list[dict[str, Any]] = []
+    for entry in _audit_rows(manager, "decision_narrative"):
+        metadata = dict(entry.get("metadata") or {})
+        if metadata.get("schema") != NARRATIVE_SCHEMA:
+            continue
+        if bundle_id is not None and str(metadata.get("bundle_id")) != str(bundle_id):
+            continue
+        rows.append({
+            "entity_id": entry.get("entity_id"),
+            "timestamp": entry.get("timestamp"),
+            "checksum": entry.get("checksum"),
+            **metadata,
+        })
+    rows.sort(key=lambda row: (
+        str(row.get("bundle_id") or ""), int(row.get("order") or 0),
+        str(row.get("entity_id") or ""),
+    ))
+    return rows
+
+
+def list_bundles(manager: Any) -> list[dict[str, Any]]:
+    """Summarise narrative bundles without inventing a second index."""
+    grouped: dict[str, list[dict[str, Any]]] = {}
+    for row in list_narratives(manager):
+        grouped.setdefault(str(row["bundle_id"]), []).append(row)
+    result = []
+    for bundle_id, rows in grouped.items():
+        first = rows[0]
+        result.append({
+            "bundle_id": bundle_id,
+            "title": first.get("bundle_title") or bundle_id,
+            "subtitle": first.get("bundle_subtitle"),
+            "step_count": sum(not bool(row.get("is_conclusion")) for row in rows),
+            "has_conclusion": any(bool(row.get("is_conclusion")) for row in rows),
+            "updated_at": max(str(row.get("timestamp") or "") for row in rows),
+        })
+    result.sort(key=lambda row: (row["updated_at"], row["bundle_id"]), reverse=True)
+    return result
+
+
+def list_reviews(manager: Any, bundle_id: str) -> list[dict[str, Any]]:
+    """Return durable review entries for a narrative bundle."""
+    reviews = []
+    for entry in _audit_rows(manager, "decision_review"):
+        metadata = dict(entry.get("metadata") or {})
+        if metadata.get("schema") != REVIEW_SCHEMA:
+            continue
+        if str(metadata.get("bundle_id")) != str(bundle_id):
+            continue
+        reviews.append({
+            "entity_id": entry.get("entity_id"),
+            "timestamp": entry.get("timestamp"),
+            "checksum": entry.get("checksum"),
+            "sequence_id": entry.get("sequence_id"),
+            **metadata,
+        })
+    reviews.sort(key=lambda row: (str(row.get("timestamp") or ""),
+                                  str(row.get("entity_id") or "")))
+    return reviews
+
+
+def _improvement(issue_source: str) -> dict[str, str]:
+    targets = {
+        "POLICY_GAP": (
+            "POLICY",
+            "Clarify the missing boundary or conflict rule, version the policy, and re-audit "
+            "the affected decisions.",
+        ),
+        "EVIDENCE_OR_TOOLING": (
+            "EVIDENCE_OR_TOOLING",
+            "Improve retrieval or tool behavior, then verify that the needed evidence was "
+            "observable before changing decision policy.",
+        ),
+        "TRACE_INSUFFICIENT": (
+            "TRACE_INSTRUMENTATION",
+            "Capture the missing state, evidence reference, or contemporaneous decision basis.",
+        ),
+        "DECISION_JUDGMENT": (
+            "DECISION_POLICY",
+            "Add a targeted example, constraint, or adjudicated precedent for this decision.",
+        ),
+    }
+    target, recommendation = targets.get(
+        issue_source, ("NONE", "No improvement target was identified."))
+    return {"target": target, "recommendation": recommendation}
+
+
+def derive_attribution(step_verdicts: list[dict[str, Any]], final_verdict: str,
+                       final_issue_source: str) -> dict[str, Any]:
+    """Locate the earliest human-confirmed material problem in reading order."""
+    incorrect = [(index, row) for index, row in enumerate(step_verdicts)
+                 if row["verdict"] == "INCORRECT"]
+    first = incorrect[0] if incorrect else None
+    material = next(((index, row) for index, row in incorrect
+                     if row["materiality"] == "CHANGES_FINAL"), None)
+    primary = material if final_verdict == "INCORRECT" else material or first
+    primary_source = primary[1]["issue_source"] if primary else final_issue_source
+    if final_verdict == "UNSURE" or any(row["verdict"] == "UNSURE"
+                                        for row in step_verdicts):
+        outcome = "UNREVIEWABLE_TRACE_INSUFFICIENT"
+        primary_source = primary_source if primary_source != "NONE" else "TRACE_INSUFFICIENT"
+    elif final_verdict == "CORRECT" and incorrect:
+        outcome = "CORRECT_OUTCOME_FLAWED_REASONING"
+    elif final_verdict == "CORRECT":
+        outcome = "PASS"
+    else:
+        outcome = {
+            "POLICY_GAP": "FAIL_POLICY_GAP",
+            "EVIDENCE_OR_TOOLING": "FAIL_EVIDENCE_OR_TOOLING",
+            "TRACE_INSUFFICIENT": "UNREVIEWABLE_TRACE_INSUFFICIENT",
+        }.get(primary_source, "FAIL_DECISION_JUDGMENT")
+        if primary_source == "NONE":
+            primary_source = "DECISION_JUDGMENT"
+    primary_index = primary[0] if primary else None
+    return {
+        "outcome": outcome,
+        "first_incorrect_step_id": first[1]["step_id"] if first else None,
+        "primary_material_step_id": primary[1]["step_id"] if primary else None,
+        "primary_issue_source": primary_source,
+        "downstream_potentially_contaminated_step_ids": (
+            [row["step_id"] for row in step_verdicts[primary_index + 1:]]
+            if primary_index is not None else []
+        ),
+        "improvement": _improvement(primary_source),
+    }
+
+
+def save_review(manager: Any, bundle_id: str,
+                submission: DecisionReviewSubmission) -> tuple[dict[str, Any], bool]:
+    """Validate and append one review through Semantica's provenance store."""
+    narratives = list_narratives(manager, bundle_id)
+    if not narratives:
+        raise ValueError(f"unknown decision narrative bundle {bundle_id!r}")
+    expected = [str(row["entity_id"]) for row in narratives if not row.get("is_conclusion")]
+    supplied = [row.step_id for row in submission.step_verdicts]
+    if len(supplied) != len(set(supplied)) or set(supplied) != set(expected):
+        raise ValueError(
+            f"step_verdicts must cover the narrative exactly; expected={expected}, "
+            f"supplied={supplied}"
+        )
+    by_id = {row.step_id: row.model_dump() for row in submission.step_verdicts}
+    ordered = [by_id[step_id] for step_id in expected]
+    has_material_error = any(
+        row["verdict"] == "INCORRECT" and row["materiality"] == "CHANGES_FINAL"
+        for row in ordered
+    )
+    if (submission.final_answer_verdict == "INCORRECT"
+            and submission.final_issue_source == "NONE" and not has_material_error):
+        raise ValueError(
+            "an incorrect final answer requires a material step error or final_issue_source"
+        )
+    if submission.final_answer_verdict == "CORRECT" \
+            and submission.final_issue_source != "NONE":
+        raise ValueError("a correct final answer cannot carry final_issue_source")
+    if submission.final_answer_verdict == "UNSURE" \
+            and submission.final_issue_source not in {"NONE", "TRACE_INSUFFICIENT"}:
+        raise ValueError("an unsure final answer may only use TRACE_INSUFFICIENT")
+
+    comparable = {
+        "review_id": submission.review_id,
+        "reviewer": submission.reviewer,
+        "step_verdicts": ordered,
+        "final_answer_verdict": submission.final_answer_verdict,
+        "final_issue_source": submission.final_issue_source,
+        "final_rationale": submission.final_rationale,
+    }
+    existing = next((row for row in list_reviews(manager, bundle_id)
+                     if row.get("review_id") == submission.review_id), None)
+    if existing is not None:
+        if any(existing.get(key) != value for key, value in comparable.items()):
+            raise ValueError("review_id already exists with different content")
+        return existing, False
+
+    derived = derive_attribution(
+        ordered, submission.final_answer_verdict, submission.final_issue_source)
+    entity_id = "decision-review:" + hashlib.sha256(
+        f"{bundle_id}:{submission.review_id}".encode("utf-8")).hexdigest()[:32]
+    conclusion = next((row for row in narratives if row.get("is_conclusion")), narratives[-1])
+    used_entities = list(dict.fromkeys([
+        *(str(row["entity_id"]) for row in narratives),
+        *(str(decision_id) for row in narratives
+          for decision_id in row.get("decision_ids") or []),
+    ]))
+    metadata = {
+        "schema": REVIEW_SCHEMA,
+        "bundle_id": bundle_id,
+        **comparable,
+        "derived": derived,
+    }
+    entry = manager.track_entity(
+        entity_id=entity_id,
+        source=str(conclusion["entity_id"]),
+        metadata=metadata,
+        entity_type="decision_review",
+        activity_id=f"human_review:{submission.review_id}",
+        agent_id=submission.reviewer,
+        agent_type="person",
+        is_automated=False,
+        role="reviewer",
+        parent_entity_id=str(conclusion["entity_id"]),
+        used_entities=used_entities,
+        bundle_id=bundle_id,
+    )
+    if entry is None:
+        raise RuntimeError("Semantica failed to persist the decision review")
+    record = {
+        "entity_id": entry.entity_id,
+        "timestamp": entry.timestamp,
+        "checksum": entry.checksum,
+        "sequence_id": entry.sequence_id,
+        **metadata,
+    }
+    return record, True
diff --git a/semantica/explorer/routes/decision_review.py b/semantica/explorer/routes/decision_review.py
