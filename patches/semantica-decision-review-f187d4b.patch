@@ -0,0 +1,55 @@
+"""Decision narrative and durable human-review routes."""
+
+from __future__ import annotations
+
+import asyncio
+
+from fastapi import APIRouter, Depends, HTTPException
+
+from ..decision_review import (
+    DecisionReviewSubmission,
+    list_bundles,
+    list_narratives,
+    list_reviews,
+    save_review,
+)
+from ..dependencies import get_session
+from ..session import GraphSession
+
+
+router = APIRouter(prefix="/api/decision-review", tags=["Decision Review"])
+
+
+@router.get("/bundles")
+async def get_bundles(session: GraphSession = Depends(get_session)):
+    return await asyncio.to_thread(list_bundles, session.provenance_manager)
+
+
+@router.get("/bundles/{bundle_id}")
+async def get_bundle(bundle_id: str, session: GraphSession = Depends(get_session)):
+    rows = await asyncio.to_thread(list_narratives, session.provenance_manager, bundle_id)
+    if not rows:
+        raise HTTPException(status_code=404, detail=f"Narrative bundle '{bundle_id}' not found")
+    return {"bundle_id": bundle_id, "steps": rows}
+
+
+@router.get("/bundles/{bundle_id}/reviews")
+async def get_reviews(bundle_id: str, session: GraphSession = Depends(get_session)):
+    return {
+        "bundle_id": bundle_id,
+        "reviews": await asyncio.to_thread(
+            list_reviews, session.provenance_manager, bundle_id),
+    }
+
+
+@router.post("/bundles/{bundle_id}/reviews", status_code=201)
+async def create_review(body: DecisionReviewSubmission, bundle_id: str,
+                        session: GraphSession = Depends(get_session)):
+    try:
+        record, created = await asyncio.to_thread(
+            save_review, session.provenance_manager, bundle_id, body)
+    except ValueError as exc:
+        raise HTTPException(status_code=409 if "already exists" in str(exc) else 422,
+                            detail=str(exc)) from exc
+    return {"record": record, "created": created,
+            "integrity": await asyncio.to_thread(session.provenance_manager.verify_chain)}
