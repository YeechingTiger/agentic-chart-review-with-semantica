+"""Decision narratives stay readable while human review uses audit provenance."""
+
+from fastapi.testclient import TestClient
+
+from semantica.context import ContextGraph
+from semantica.explorer.app import create_app
+from semantica.explorer.decision_review import NARRATIVE_SCHEMA
+from semantica.explorer.session import GraphSession
+
+
+def _client(tmp_path):
+    graph = ContextGraph(advanced_analytics=False)
+    first = graph.record_decision(
+        category="where_to_look", scenario="An inventory is available",
+        reasoning="Inspect likely evidence sources first", outcome="read pathology",
+        confidence=0.9,
+    )
+    final = graph.record_decision(
+        category="what_to_answer", scenario="Three candidate dates",
+        reasoning="The earliest establishing date wins", outcome="select candidate 2",
+        confidence=0.9,
+    )
+    graph.add_causal_relationship(first, final, "INFLUENCED")
+    session = GraphSession(
+        graph, provenance_storage_path=str(tmp_path / "provenance.sqlite3"))
+    pm = session.provenance_manager
+    bundle = "run-a:analysis-a"
+    step_id = "narrative:step-1"
+    final_id = "narrative:conclusion"
+    pm.track_entity(
+        step_id, source="trace-a", entity_type="decision_narrative",
+        activity_id="narrative_projection", agent_id="reconstructor",
+        used_entities=[first], bundle_id=bundle,
+        metadata={
+            "schema": NARRATIVE_SCHEMA, "bundle_id": bundle, "order": 1,
+            "bundle_title": "First diagnosis date", "title": "Inspect pathology",
+            "question": "Where can an establishing date be found?",
+            "known_before": ["The chart inventory contains pathology and clinical notes"],
+            "rationale": "The policy allows either source type",
+            "actions": [{"name": "read", "objective": "inspect pathology"}],
+            "observations": ["One pathology date became a candidate"],
+            "candidate_changes": {"before": [], "after": ["candidate 1"]},
+            "basis": [{"kind": "policy", "label": "evidence rule 1"}],
+            "decision": "Continue to clinical notes before selecting the earliest date",
+            "why_next_or_stop": "An earlier clinical date could still change the answer",
+            "decision_ids": [first], "is_conclusion": False,
+        },
+    )
+    pm.track_entity(
+        final_id, source="trace-a", entity_type="decision_narrative",
+        activity_id="narrative_projection", agent_id="reconstructor",
+        parent_entity_id=step_id, used_entities=[step_id, final], bundle_id=bundle,
+        metadata={
+            "schema": NARRATIVE_SCHEMA, "bundle_id": bundle, "order": 2,
+            "bundle_title": "First diagnosis date", "title": "Final answer",
+            "question": "Which candidate is earliest?", "known_before": ["Three candidates"],
+            "rationale": "Compare all establishing dates", "actions": [],
+            "observations": [], "candidate_changes": {"before": ["1", "2", "3"],
+                                                        "after": ["2"]},
+            "basis": [{"kind": "policy", "label": "earliest-date rule"}],
+            "decision": "Select candidate 2", "why_next_or_stop": "All source types checked",
+            "decision_ids": [final], "is_conclusion": True,
+        },
+    )
+    return TestClient(create_app(session=session)), session, bundle, step_id
+
+
+def test_narrative_bundle_is_ordered_and_human_readable(tmp_path):
+    client, _session, bundle, _step_id = _client(tmp_path)
+    with client:
+        bundles = client.get("/api/decision-review/bundles")
+        narrative = client.get(f"/api/decision-review/bundles/{bundle}")
+
+    assert bundles.status_code == narrative.status_code == 200
+    assert bundles.json()[0]["title"] == "First diagnosis date"
+    assert bundles.json()[0]["step_count"] == 1
+    steps = narrative.json()["steps"]
+    assert [row["order"] for row in steps] == [1, 2]
+    assert steps[0]["known_before"] == [
+        "The chart inventory contains pathology and clinical notes"]
+    assert steps[0]["why_next_or_stop"].startswith("An earlier clinical date")
+
+
+def test_review_is_idempotent_hash_chained_provenance_not_annotation(tmp_path):
+    client, session, bundle, step_id = _client(tmp_path)
+    payload = {
+        "review_id": "review-a", "reviewer": "domain-expert",
+        "step_verdicts": [{
+            "step_id": step_id, "verdict": "INCORRECT",
+            "corrected_decision": "Inspect both source types before preferring either",
+            "issue_source": "POLICY_GAP", "materiality": "CHANGES_FINAL",
+            "note": "The source-order instruction is ambiguous",
+        }],
+        "final_answer_verdict": "INCORRECT", "final_issue_source": "NONE",
+        "final_rationale": "The conclusion inherited the first material error",
+    }
+    with client:
+        created = client.post(
+            f"/api/decision-review/bundles/{bundle}/reviews", json=payload)
+        duplicate = client.post(
+            f"/api/decision-review/bundles/{bundle}/reviews", json=payload)
+        history = client.get(f"/api/decision-review/bundles/{bundle}/reviews")
+
+    assert created.status_code == duplicate.status_code == 201
+    assert created.json()["created"] is True
+    assert duplicate.json()["created"] is False
+    assert created.json()["integrity"]["valid"] is True
+    assert len(history.json()["reviews"]) == 1
+    record = history.json()["reviews"][0]
+    assert record["derived"]["primary_material_step_id"] == step_id
+    assert record["derived"]["improvement"]["target"] == "POLICY"
+    stored = session.provenance_manager.storage.retrieve(record["entity_id"])
+    assert stored.entity_type == "decision_review"
+    assert stored.agent_type == "person"
+    assert stored.role == "reviewer"
+    assert session.annotations == {}
+
+
+def test_review_must_cover_exactly_the_visible_non_conclusion_steps(tmp_path):
+    client, _session, bundle, _step_id = _client(tmp_path)
+    with client:
+        response = client.post(f"/api/decision-review/bundles/{bundle}/reviews", json={
+            "review_id": "review-incomplete", "reviewer": "domain-expert",
+            "step_verdicts": [], "final_answer_verdict": "CORRECT",
+            "final_issue_source": "NONE", "final_rationale": "Looks right",
+        })
+
+    assert response.status_code == 422
+    assert "cover the narrative exactly" in response.json()["detail"]
